# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://teambud.vercel.app"

# Paystack API Keys (Nigerian Payments)
# PAYSTACK_SECRET_KEY: Used strictly on the server/API to initialize and verify payments. Never expose in frontend.
PAYSTACK_SECRET_KEY="sk_test_your_secret_key_here"

# VITE_PAYSTACK_PUBLIC_KEY: Public key for client-side payment popup integration.
VITE_PAYSTACK_PUBLIC_KEY="pk_test_your_public_key_here"

# PAYSTACK_WEBHOOK_SECRET: Secret used to verify x-paystack-signature on incoming webhook events.
PAYSTACK_WEBHOOK_SECRET="your_webhook_secret_here"
